{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    // 3.5 Flash Lite: najstabilniejsze wyniki w testach; 3.5 Flash ma na darmowym planie tylko 20 zapytan dziennie.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_FALLBACK_MODELS": "gemini-3.5-flash,gemini-3.1-flash-lite",
    "ALLOWED_ORIGINS": "https://dominoxxx111.github.io",
  },
  // Limity zapytan (darmowy mechanizm Cloudflare): 10 analiz na minute z jednego IP
  // i 60 na minute lacznie - zeby naduzycie nie wyczerpalo darmowej puli Gemini.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } },
  ],
}
